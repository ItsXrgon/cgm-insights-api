# Application
# development, or anything else (production, staging) for strict settings
APP_ENV=development
PORT=3000

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/cgm_insights

# Authentication: required outside development, at least 32 random characters
# (e.g. openssl rand -hex 32). The placeholder below is rejected outside development.
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Sentry (Optional)
SENTRY_DSN=
# Override release. Default: cgm-insights-api@{version}-{7-char-git-sha} (set at build time)
# SENTRY_RELEASE=cgm-insights-api@0.2.0-custom
# Trace sampling 0.0-1.0. Default 0.1.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# CORS Configuration (production only; comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:3000

# CGM background sync interval (optional, default 900 = 15 min; keep well under 12 h,
# LibreLink only returns ~12 h of history)
SYNC_INTERVAL_SECS=900
# Minimum seconds between sync attempts per credential (optional, default 60)
SYNC_COOLDOWN_SECS=60

# Logging
RUST_LOG=info
